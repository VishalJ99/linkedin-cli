{
  "manifest_version": 3,
  "name": "LinkedIn Conversation Finder Connector",
  "version": "0.1.0",
  "key": "",
  "description": "Pairs an explicitly approved LinkedIn session with the private conversation finder.",
  "minimum_chrome_version": "109",
  "permissions": [],
  "optional_permissions": [
    "cookies"
  ],
  "optional_host_permissions": [
    "https://*.linkedin.com/*",
    "https://*.up.railway.app/*",
    "https://*.railway.app/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "LinkedIn connector status",
    "default_popup": "popup.html"
  },
  "externally_connectable": {
    "matches": [
      "https://*.up.railway.app/*",
      "https://*.railway.app/*"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
